# OpenAI Platform에서 발급한 API 키입니다. 실제 키를 이 파일에 커밋하지 마세요.
OPENAI_API_KEY=

# Responses API의 Structured Outputs를 지원하는 모델을 사용합니다.
OPENAI_MODEL=gpt-5.4-mini

# 로컬 개발은 비워 두면 file:./data/app.db를 사용합니다.
# 원격 Turso 사용 시 libsql://... URL을 입력하세요.
TURSO_DATABASE_URL=

# 원격 Turso URL을 사용할 때만 필요합니다.
TURSO_AUTH_TOKEN=
