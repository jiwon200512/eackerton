# OpenAI Platform에서 발급한 API 키
OPENAI_API_KEY=

# structured output을 지원하는 GPT 모델
OPENAI_MODEL=gpt-5.4-mini

# Turso(libSQL) 데이터베이스 URL.
# 비워두면 로컬 파일(./data/app.db)을 사용합니다 (계정 없이 개발 가능).
# 배포 시에는 Turso 대시보드에서 발급받은 libsql://... URL을 입력하세요.
TURSO_DATABASE_URL=

# 위 URL이 libsql://... (원격 Turso DB)일 때만 필요한 인증 토큰.
# `turso db tokens create <db-name>` 명령으로 발급받을 수 있습니다.
TURSO_AUTH_TOKEN=

